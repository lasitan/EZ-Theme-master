# =============================================================================
# EZ Theme 站点配置
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env.development（本地 npm run serve）
#      或 .env.production（打包 npm run build）
#   2. 只改等号右边的值，不要改变量名
#   3. 改完后必须重新启动 / 重新打包才会生效
#
# 写法注意：
#   - 前端只能读取以 VUE_APP_ 开头的变量
#   - true / false 一律小写
#   - 颜色值带 #、HTML 内容请用双引号包起来，例如 "#355cc2"
#   - 列表用英文逗号分隔，不要加空格也可以，有空格会自动去掉
#   - 留空表示使用代码里的缺省值
# =============================================================================

# ==================== 构建 ====================
# 当前环境标识，仅作标记，可选 production / development
VUE_APP_ENV=production
# 是否启用反调试（阻止 F12 / 开发者工具），true=开启，false=关闭；建议生产开、本地关
VUE_APP_DEBUGGING=false
# 打包时是否生成独立混淆配置 JS。false=配置打进主包；true=额外输出独立配置文件
VUE_APP_CONFIGJS=false

# ==================== 网站 ====================
# 网站名称，会显示在标题、Logo 旁、登录页等
VUE_APP_SITE_NAME=黑心云|府
# 网站描述，可用于简介文案
VUE_APP_SITE_DESCRIPTION=黑心云|府
# 是否在标题旁显示 Logo 图片（images/logo.png），true=显示，false=隐藏
VUE_APP_SHOW_LOGO=true
# 自定义落地页文件名，相对于 public 目录，例如 landingpage.html；留空则用默认落地页
VUE_APP_CUSTOM_LANDING_PAGE=
# 落地页多语言标语
VUE_APP_LANDING_TEXT_ZH_CN=世界那么大，我想云游一下
VUE_APP_LANDING_TEXT_VI_VN=Thế giới thật rộng lớn, tôi muốn du ngoạn trên mây
VUE_APP_LANDING_TEXT_EN_US=The world is vast, I want to roam the cloud
VUE_APP_LANDING_TEXT_ZH_TW=世界那麼大，我想雲遊一下
VUE_APP_LANDING_TEXT_JA_JP=世界はとても広い、クラウドを旅したい
VUE_APP_LANDING_TEXT_KO_KR=세상은 이렇게 넓다, 클라우드를 유람하고 싶다
VUE_APP_LANDING_TEXT_RU_RU=Мир так велик, хочу странствовать по облакам
VUE_APP_LANDING_TEXT_FA_IR=دنیا بسیار بزرگ است، می‌خواهم در ابرها گردش کنم

# ==================== 默认语言 / 主题 ====================
# 首次进入时的默认语言，例如 zh-CN、en-US、zh-TW、ja-JP、ko-KR、vi-VN、ru-RU、fa-IR
VUE_APP_DEFAULT_LANGUAGE=zh-CN
# 首次进入时的默认主题，light=浅色，dark=深色
VUE_APP_DEFAULT_THEME=light
# 主题色，16 进制，必须加双引号
VUE_APP_PRIMARY_COLOR="#355cc2"
# 是否启用落地页。true=未登录先看落地页；false=直接进入登录/面板
VUE_APP_ENABLE_LANDING_PAGE=true

# ==================== API ====================
# Xboard 接口前缀，一般保持 /api/v1；若前后端分离可写成完整地址，例如 https://api.example.com/api/v1
VUE_APP_API_BASE_URL=/api/v1

# ==================== 认证 ====================
# 登录/注册页是否默认勾选同意条款
VUE_APP_AUTH_AUTO_AGREE_TERMS=true
# 发送验证码后是否提示检查垃圾邮件
VUE_APP_AUTH_SHOW_CHECK_SPAM_TIP=true
# 显示垃圾邮件提示的延迟，单位毫秒
VUE_APP_AUTH_CHECK_SPAM_TIP_DELAY=1000
# 认证页是否弹出公告，true=弹出，false=不弹
VUE_APP_AUTH_POPUP_ENABLED=false
# 认证页公告标题
VUE_APP_AUTH_POPUP_TITLE=用户须知 (可自定义开启)
# 认证页公告内容，支持 HTML，请用双引号包起来
VUE_APP_AUTH_POPUP_CONTENT="<p><strong>欢迎使用我们的服务！</strong></p><p>请注意以下事项：</p><ul><li>请妥善保管您的账号信息</li><li>如有问题请联系客服</li></ul>"
# 认证页公告冷却时间，单位小时；0=每次进入都显示
VUE_APP_AUTH_POPUP_COOLDOWN_HOURS=0
# 认证页公告需等待多少秒才能关闭，0=立即可以关
VUE_APP_AUTH_POPUP_CLOSE_WAIT_SECONDS=3
# 认证页布局：split=左右分栏，center=居中卡片
VUE_APP_AUTH_LAYOUT_TYPE=split
# 左右分栏时左侧背景图，可以是 URL 或本地路径；留空则无图
VUE_APP_AUTH_SPLIT_BG_IMAGE=https://www.loliapi.com/acg
# 左侧是否显示网站名称
VUE_APP_AUTH_SPLIT_SITE_NAME_SHOW=true
# 左侧网站名称颜色，white 或 black
VUE_APP_AUTH_SPLIT_SITE_NAME_COLOR=white
# 左侧是否显示问候语
VUE_APP_AUTH_SPLIT_GREETING_SHOW=true
# 左侧问候语颜色，white 或 black
VUE_APP_AUTH_SPLIT_GREETING_COLOR=white

# ==================== 商店 / 订单 ====================
# 商店导航是否显示「热销」标记
VUE_APP_SHOP_SHOW_HOT_SALE_BADGE=false
# 是否显示套餐特性卡片
VUE_APP_SHOP_SHOW_PLAN_FEATURE_CARDS=true
# 是否自动选中最长周期；false=不自动选
VUE_APP_SHOP_AUTO_SELECT_MAX_PERIOD=false
# 是否隐藏周期选择标签；false=显示月付/年付等
VUE_APP_SHOP_HIDE_PERIOD_TABS=false
# 库存小于等于该数量且大于 0 时显示「库存紧张」
VUE_APP_SHOP_LOW_STOCK_THRESHOLD=5
# 显示「推荐购买」的套餐序号，从 1 开始，多个用逗号分隔，例如 1,3
VUE_APP_SHOP_RECOMMENDED_PLAN_INDICES=3
# 推荐购买徽章上的文字
VUE_APP_SHOP_RECOMMENDED_BADGE_TEXT=推荐购买
# 是否显示周期折扣计算
VUE_APP_SHOP_ENABLE_DISCOUNT_CALCULATION=false
# 价格周期展示顺序（从大到小），英文逗号分隔
# 可选：three_year_price, two_year_price, year_price, half_year_price, quarter_price, month_price, onetime_price
VUE_APP_SHOP_PERIOD_ORDER=three_year_price,two_year_price,year_price,half_year_price,quarter_price,month_price,onetime_price
# 商店页是否弹出须知
VUE_APP_SHOP_POPUP_ENABLED=false
VUE_APP_SHOP_POPUP_TITLE=用户须知
VUE_APP_SHOP_POPUP_CONTENT="<p><strong>常规套餐默认每月订单日重置流量，您当月未用使用完的流量，不会累积到下个月</strong></p>"
VUE_APP_SHOP_POPUP_COOLDOWN_HOURS=0
VUE_APP_SHOP_POPUP_CLOSE_WAIT_SECONDS=0
# 下单前是否二次确认
VUE_APP_ORDER_CONFIRM=true
# 二次确认弹窗内容，支持 HTML
VUE_APP_ORDER_CONFIRM_CONTENT="<p><strong style='color: red'>无法提供相关教程和使用说明。</strong></p><p><strong style='color: red'>不会使用请勿购买，没有退款政策</strong></p>"

# ==================== 仪表盘 ====================
# 欢迎卡片是否显示用户邮箱
VUE_APP_DASHBOARD_SHOW_USER_EMAIL=false
# 导入订阅按钮是否加高光填充
VUE_APP_DASHBOARD_IMPORT_HIGHLIGHT=false
# 是否启用重置流量功能
VUE_APP_DASHBOARD_ENABLE_RESET_TRAFFIC=true
# 重置流量按钮显示条件：always=始终显示，low=低于阈值时显示，depleted=流量耗尽时显示
VUE_APP_DASHBOARD_RESET_TRAFFIC_MODE=low
# 低流量阈值，剩余流量百分比低于该值视为偏低，范围 1-100
VUE_APP_DASHBOARD_LOW_TRAFFIC_THRESHOLD=10
# 是否启用续费套餐功能
VUE_APP_DASHBOARD_ENABLE_RENEW_PLAN=true
# 续费按钮显示条件：always=始终显示，expiring=即将过期时显示，expired=已过期时显示
VUE_APP_DASHBOARD_RENEW_PLAN_MODE=always
# 即将过期天数阈值，剩余天数小于等于该值视为即将过期，范围 1-30
VUE_APP_DASHBOARD_EXPIRING_THRESHOLD=7
# 是否显示导入订阅入口
VUE_APP_DASHBOARD_SHOW_IMPORT_SUBSCRIPTION=true
# 仪表盘「群聊」按钮和 More 页默认 Telegram 卡片使用的链接；留空则不显示群聊按钮
VUE_APP_GROUP_CHAT_URL=https://t.me/heixinyun_chat

# ==================== 客户端下载 ====================
# 是否显示整个客户端下载卡片
VUE_APP_CLIENT_SHOW_DOWNLOAD_CARD=true
# 各系统下载入口是否显示
VUE_APP_CLIENT_SHOW_IOS=true
VUE_APP_CLIENT_SHOW_ANDROID=true
VUE_APP_CLIENT_SHOW_MACOS=true
VUE_APP_CLIENT_SHOW_WINDOWS=true
VUE_APP_CLIENT_SHOW_LINUX=true
VUE_APP_CLIENT_SHOW_OPENWRT=true
# 各系统下载 / 文档链接，点击后新标签打开
VUE_APP_CLIENT_LINK_IOS=https://apps.apple.com/us/app/hiddify-proxy-vpn/id6596777532
VUE_APP_CLIENT_LINK_ANDROID=https://github.com/chen08209/FlClash/releases
VUE_APP_CLIENT_LINK_MACOS=https://github.com/chen08209/FlClash/releases
VUE_APP_CLIENT_LINK_WINDOWS=https://github.com/clash-verge-rev/clash-verge-rev/releases
VUE_APP_CLIENT_LINK_LINUX=https://github.com/clash-verge-rev/clash-verge-rev/releases
VUE_APP_CLIENT_LINK_OPENWRT=https://github.com/vernesong/OpenClash/releases
# 一键导入订阅时，各客户端是否显示。部分面板不支持 SingBox 导入，请按实际情况关闭
# iOS
VUE_APP_CLIENT_SHOW_SHADOWROCKET=true
VUE_APP_CLIENT_SHOW_SURGE=true
VUE_APP_CLIENT_SHOW_STASH=true
VUE_APP_CLIENT_SHOW_QUANTUMULTX=true
VUE_APP_CLIENT_SHOW_HIDDIFY_IOS=true
VUE_APP_CLIENT_SHOW_SINGBOX_IOS=true
VUE_APP_CLIENT_SHOW_LOON=true
# Android
VUE_APP_CLIENT_SHOW_FLCLASH_ANDROID=true
VUE_APP_CLIENT_SHOW_V2RAYNG=true
VUE_APP_CLIENT_SHOW_CLASH_ANDROID=true
VUE_APP_CLIENT_SHOW_SURFBOARD=true
VUE_APP_CLIENT_SHOW_CLASHMETA_ANDROID=true
VUE_APP_CLIENT_SHOW_NEKOBOX=true
VUE_APP_CLIENT_SHOW_SINGBOX_ANDROID=true
VUE_APP_CLIENT_SHOW_HIDDIFY_ANDROID=true
# Windows
VUE_APP_CLIENT_SHOW_FLCLASH_WINDOWS=true
VUE_APP_CLIENT_SHOW_CLASHVERGE_WINDOWS=true
VUE_APP_CLIENT_SHOW_CLASH_WINDOWS=true
VUE_APP_CLIENT_SHOW_NEKORAY=true
VUE_APP_CLIENT_SHOW_SINGBOX_WINDOWS=true
VUE_APP_CLIENT_SHOW_HIDDIFY_WINDOWS=true
# macOS
VUE_APP_CLIENT_SHOW_FLCLASH_MAC=true
VUE_APP_CLIENT_SHOW_CLASHVERGE_MAC=true
VUE_APP_CLIENT_SHOW_CLASHX=true
VUE_APP_CLIENT_SHOW_CLASHMETAX=true
VUE_APP_CLIENT_SHOW_SURGE_MAC=true
VUE_APP_CLIENT_SHOW_STASH_MAC=true
VUE_APP_CLIENT_SHOW_QUANTUMULTX_MAC=true
VUE_APP_CLIENT_SHOW_SINGBOX_MAC=true
VUE_APP_CLIENT_SHOW_HIDDIFY_MAC=true

# ==================== 用户中心 ====================
# 是否显示礼品卡兑换
VUE_APP_PROFILE_SHOW_GIFT_CARD_REDEEM=true
# 是否显示最近登录设备
VUE_APP_PROFILE_SHOW_RECENT_DEVICES=true

# ==================== 安全 / 验证码 / 盾牌 ====================
# 是否在配置层再开一层反调试；通常与 VUE_APP_DEBUGGING 配合，生产建议 true
VUE_APP_ENABLE_ANTI_DEBUGGING=false
# 是否校验前端访问域名，未在授权列表中的域名将无法使用
VUE_APP_ENABLE_FRONTEND_DOMAIN_CHECK=false
# 是否启用授权码校验
VUE_APP_ENABLE_LICENSE_CHECK=true
# 授权前端域名，多个用逗号分隔，例如 a.com,b.com；不要带 https://
VUE_APP_AUTHORIZED_DOMAINS=heixin.pp.ua
# 人机验证方式：google 或 cloudflare
VUE_APP_CAPTCHA_TYPE=cloudflare
# Google reCAPTCHA 校验接口，一般不用改
VUE_APP_CAPTCHA_GOOGLE_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
# Cloudflare Turnstile 校验接口，一般不用改
VUE_APP_CAPTCHA_CLOUDFLARE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# 是否给所有 API 请求附加自定义请求头；开启前请确认后端 CORS 已放行这些头
VUE_APP_CUSTOM_HEADERS_ENABLED=false
# 自定义请求头 JSON 对象，例如 {"X-Custom-Header":"value"}
VUE_APP_CUSTOM_HEADERS_JSON={}
# 是否启用 Cloudflare Turnstile 盾牌页
VUE_APP_TURNSTILE_ENABLED=true
# Turnstile Site Key（公钥），在 Cloudflare 控制台获取；留空则盾牌页会提示未配置
VUE_APP_TURNSTILE_SITE_KEY=
# 盾牌令牌有效期，单位毫秒，默认 10800000=3 小时
VUE_APP_TURNSTILE_TOKEN_TTL_MS=10800000

# ==================== 支付 ====================
# 支付链接是否在新标签页打开；false=当前页跳转
VUE_APP_PAYMENT_OPEN_IN_NEW_TAB=true
# 支付二维码边长，单位像素
VUE_APP_PAYMENT_QRCODE_SIZE=200
# 二维码前景色，必须加双引号
VUE_APP_PAYMENT_QRCODE_COLOR="#000000"
# 二维码背景色，必须加双引号
VUE_APP_PAYMENT_QRCODE_BACKGROUND="#ffffff"
# 是否自动轮询支付状态
VUE_APP_PAYMENT_AUTO_CHECK=true
# 自动检测间隔，单位毫秒
VUE_APP_PAYMENT_AUTO_CHECK_INTERVAL=5000
# 自动检测最大次数，0=不限制
VUE_APP_PAYMENT_AUTO_CHECK_MAX_TIMES=60
# Safari 是否使用支付弹窗而不是直接跳转
VUE_APP_PAYMENT_SAFARI_MODAL=true
# 进入支付页是否自动选中第一个支付方式
VUE_APP_PAYMENT_AUTO_SELECT_FIRST=true

# ==================== 邀请 ====================
# 导航栏邀请按钮是否显示返利标记
VUE_APP_INVITE_SHOW_COMMISSION_BADGE=false
# 返佣记录每页条数，最小为 10（接口限制）
VUE_APP_INVITE_RECORDS_PER_PAGE=10
# 邀请链接模式：auto=用当前站点域名，custom=用下面的自定义域名
VUE_APP_INVITE_LINK_MODE=auto
# 自定义邀请域名，仅当 LINK_MODE=custom 时生效，需带 https://
VUE_APP_INVITE_CUSTOM_DOMAIN=https://example.com

# ==================== 浏览器限制 ====================
# 是否拦截部分浏览器；true=按下面列表拦截，false=全部放行
VUE_APP_BROWSER_RESTRICT_ENABLED=true
# true=禁止该浏览器访问，false=允许
VUE_APP_RESTRICT_BROWSER_360=true
VUE_APP_RESTRICT_BROWSER_QQ=true
VUE_APP_RESTRICT_BROWSER_WECHAT=true
VUE_APP_RESTRICT_BROWSER_BAIDU=true
VUE_APP_RESTRICT_BROWSER_SOGOU=true
VUE_APP_RESTRICT_BROWSER_UC=false
VUE_APP_RESTRICT_BROWSER_MAXTHON=false
# 被拦截时推荐用户下载的浏览器地址
VUE_APP_RECOMMENDED_BROWSER_CHROME=https://www.google.cn/chrome/
VUE_APP_RECOMMENDED_BROWSER_EDGE=https://www.microsoft.com/edge

# ==================== 工单 / 流量 / 节点 ====================
# 创建工单时是否附带用户基础信息，方便客服排查
VUE_APP_TICKET_INCLUDE_USER_INFO=true
# 进入工单页是否弹出须知
VUE_APP_TICKET_POPUP_ENABLED=true
VUE_APP_TICKET_POPUP_TITLE=工单须知
VUE_APP_TICKET_POPUP_CONTENT="<p>请您准确描述您的问题，再提交工单，以便我们更快帮助您。</p>"
# 工单须知冷却时间，单位小时
VUE_APP_TICKET_POPUP_COOLDOWN_HOURS=24
# 工单须知等待多少秒才能关闭，0=立即可以关
VUE_APP_TICKET_POPUP_CLOSE_WAIT_SECONDS=0
# 是否启用流量明细页面
VUE_APP_TRAFFICLOG_ENABLED=true
# 流量明细展示最近多少天
VUE_APP_TRAFFICLOG_DAYS_TO_SHOW=30
# 流量趋势图是否按天聚合；节点倍率全是 1 倍时一般不用开
VUE_APP_TRAFFICLOG_SUM_DAILY=false
# 节点列表是否显示倍率；设为 false 时查看节点详情也会被关掉
VUE_APP_NODES_SHOW_RATE=true
# 是否直接在列表中展示主机和端口
VUE_APP_NODES_SHOW_DETAILS=false
# 是否允许点击查看节点详细信息
VUE_APP_NODES_ALLOW_VIEW_INFO=true

# ==================== 客服 ====================
# 是否启用客服入口
VUE_APP_CS_ENABLED=false
# 客服类型：crisp 或 other。crisp 会自动把邮箱、套餐、到期时间、流量、余额传给客服
VUE_APP_CS_TYPE=crisp
# 客服嵌入 HTML / JS 代码，type=other 时使用；内容较复杂建议写在独立文件后再粘贴
VUE_APP_CS_CUSTOM_HTML=
# 嵌入模式：popup=点击图标打开独立页，embed=每个页面内嵌（仅 crisp 支持）
VUE_APP_CS_EMBED_MODE=embed
# 未登录时是否也显示客服图标
VUE_APP_CS_SHOW_WHEN_NOT_LOGGED_IN=true
# 桌面端图标距离左下角的位置
VUE_APP_CS_DESKTOP_LEFT=20px
VUE_APP_CS_DESKTOP_BOTTOM=20px
# 移动端图标距离右下角的位置
VUE_APP_CS_MOBILE_RIGHT=20px
VUE_APP_CS_MOBILE_BOTTOM=100px

# ==================== More 页面 ====================
# 是否启用「更多」页自定义卡片
VUE_APP_MORE_ENABLE_CUSTOM_CARDS=false
# 自定义卡片 JSON 数组。留空则使用默认 Telegram 卡片（链接取 VUE_APP_GROUP_CHAT_URL）
# 示例：[{"id":"telegram","title":"Telegram","description":"加入频道","url":"https://t.me/xxx","openInNewTab":true,"svgIcon":"<svg ...>"}]
VUE_APP_MORE_CUSTOM_CARDS=
