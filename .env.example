# 复制为 .env.development / .env.production 后按需修改
# 前端只能读取以 VUE_APP_ 开头的变量

# 网站
VUE_APP_SITE_NAME=黑心云|府
VUE_APP_SITE_DESCRIPTION=黑心云|府
VUE_APP_SHOW_LOGO=true
VUE_APP_ENABLE_LANDING_PAGE=true

# Xboard API 路径
VUE_APP_API_BASE_URL=/api/v1

# 安全
VUE_APP_AUTHORIZED_DOMAINS=heixin.pp.ua
VUE_APP_TURNSTILE_ENABLED=true
VUE_APP_TURNSTILE_SITE_KEY=

# 社交
VUE_APP_GROUP_CHAT_URL=https://t.me/heixinyun_chat

# 构建
VUE_APP_ENV=production
VUE_APP_DEBUGGING=false
VUE_APP_CONFIGJS=false
